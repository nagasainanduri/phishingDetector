# ==========================================
# PhishGuard Environment Configuration
# ==========================================

# ------------------------------------------
# API & Resource Limits
# ------------------------------------------
# Maximum size in bytes for incoming JSON payloads to prevent memory exhaustion
PHISHGUARD_MAX_REQUEST_BYTES=1048576

# Maximum length for an individual URL
PHISHGUARD_MAX_URL_LENGTH=2048

# Maximum number of URLs allowed in a single batch request
PHISHGUARD_MAX_BATCH_SIZE=10

# Maximum number of URLs to process (defaults to MAX_BATCH_SIZE if not set)
PHISHGUARD_MAX_URLS_PER_REQUEST=10

# ------------------------------------------
# Canonicalization & Normalization Limits
# ------------------------------------------
# Maximum depth for recursive percent-decoding to prevent DoS via zip-bombs
PHISHGUARD_MAX_DECODE_DEPTH=5

# ------------------------------------------
# Threat Intelligence Integrations
# ------------------------------------------
# Google Safe Browsing API Key
# Sign up at: https://developers.google.com/safe-browsing/
# Leave empty to disable GSB lookups
GSB_API_KEY=

# Note: URLhaus does not require an API key for queries.
